# Base URL for the optimiser API (required for Optimise button in concept form).
OPTIMISER_API_URL=

# Optional: AWS credentials for API Gateway IAM auth. Omit if the API does not require signing.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=eu-west-2

# Optional: directory for GeoJSON/processed map data (default: repo data/processed).
# DASH_DATA_DIR=
